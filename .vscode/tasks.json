{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build star-search",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Test star-search",
      "type": "shell",
      "command": "ctest",
      "args": ["--test-dir", "build", "--output-on-failure"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Build star-search",
      "group": "test",
      "problemMatcher": []
    }
  ]
}