# star-search website (Next.js production server)
# Symlinked: /etc/systemd/system/starsearch.service -> this file
# Build first: cd web && npm ci && npm run build
[Unit]
Description=star-search website (Next.js, starsearch.abacusai.cloud)
After=network-online.target
Wants=network-online.target
# /home/ubuntu mounts late at boot (nofail); never start before project files exist.
RequiresMountsFor=/home/ubuntu

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/projects/star-search/star-search/web
Environment=NODE_ENV=production
Environment=PORT=3100
Environment=HOSTNAME=127.0.0.1
Environment=NEXT_TELEMETRY_DISABLED=1
# Loopback only; nginx is the public entry point.
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3100
Restart=on-failure
RestartSec=3
# Graceful shutdown: SIGTERM lets Next.js drain in-flight requests.
KillSignal=SIGTERM
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=starsearch
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
